{
  "name": "heart-of-universe",
  "version": "1.8.4",
  "private": true,
  "description": "宇宙之心 — AI 驱动的 3D 知识图谱、推理与执行桌面应用",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "npm run build && concurrently \"npm run start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@tailwindcss/typography": "^0.5.14",
    "@xyflow/react": "^12.11.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "iconv-lite": "^0.6.3",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.24.3",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.167.1",
    "three-spritetext": "^1.8.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.heartofuniverse.app",
    "productName": "宇宙之心",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "!node_modules/@next/swc-*/**/*.node"
    ],
    "files": [
      "electron/**/*",
      ".next/**/*",
      ".env.local",
      "package.json",
      "public/**/*",
      "node_modules/**/*",
      "!.next/cache/**/*",
      "!.next/trace",
      "!.next/types/**/*",
      "!node_modules/@next/swc-*/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.{ts,tsx,md,markdown,yml,yaml,log,scss,sass,less}",
      "!node_modules/**/{test,tests,__tests__,docs,doc,examples,samples,benchmarks,mocks,fixtures}/**/*",
      "!node_modules/**/{.gitignore,.eslintrc,.eslintrc.json,.prettierrc,tsconfig.json,package-lock.json,yarn.lock,pnpm-lock.yaml}"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "deleteAppDataOnUninstall": true
    }
  }
}
